# =============================================================================
# Gameslot — Environment Variables
# Copy to .env.local for local development. Never commit real secrets.
# Set the same keys in Vercel → Project → Settings → Environment Variables.
# =============================================================================

# --- Supabase (required) ---
# Project URL from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Use the anon / publishable JWT (starts with eyJ...). Do NOT use service_role here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (required in production) ---
# Public site origin, no trailing slash. Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe FPX (required for checkout) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: only if you later add Stripe.js on the client
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Optional contact / marketplace ---
# Digits only, e.g. 60123456789
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SHOPEE_URL=

# --- Optional email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
