# =============================================================================
# Gameslot / Baitu Games — Environment Variables
# Copy to .env.local for local development. Never commit real secrets.
# =============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (required in production) ---
# Production: https://www.baitugames.com
# Local dev:  http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.baitugames.com

# --- Public contact / store links ---
NEXT_PUBLIC_WHATSAPP_NUMBER=60102431634
NEXT_PUBLIC_SHOPEE_URL=https://shopee.com.my/gameslot

# --- Stripe (server-only, TEST keys for local) ---
# Never prefix these with NEXT_PUBLIC_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Guest order receipt signing (server-only) ---
# Required in production — use a dedicated secret (do NOT reuse STRIPE_WEBHOOK_SECRET).
# Local dev may fall back to a derivation of STRIPE_WEBHOOK_SECRET when unset.
ORDER_RECEIPT_SECRET=

# --- Inventory credential encryption (server-only) ---
# Required for production inventory credential storage.
# Exactly 32 bytes, encoded as 64 hexadecimal characters.
# Example format (DO NOT use this value): INVENTORY_ENCRYPTION_KEY=<64 hex chars>
# Never prefix with NEXT_PUBLIC_. Never commit the actual value.
INVENTORY_ENCRYPTION_KEY=
