# =============================================================================
# Gameslot — Environment Variables
# Copy to .env.local for local development. Never commit real secrets.
# =============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable JWT (starts with eyJ...). Do NOT use service_role here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (required in production) ---
# Public origin, no trailing slash. Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Public contact / store links ---
# Digits only, e.g. 60102431634
NEXT_PUBLIC_WHATSAPP_NUMBER=60102431634
NEXT_PUBLIC_SHOPEE_URL=https://shopee.com.my/gameslot

# --- Optional email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
